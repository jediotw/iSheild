        "agentsChatInput.focusBorder": "#569CD6",
        "agentsNewSessionButton.border": "#3E3E42",
        "agentsPanel.border": "#3E3E42",
        "agentsSessions.border": "#3E3E42",

        "badge.background": "#569CD6",
        "badge.foreground": "#FFFFFF",

        "button.background": "#569CD6",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#4A86B8",
        "button.secondaryBackground": "#3E3E42",
        "button.secondaryForeground": "#D4D4D4",
        "button.secondaryHoverBackground": "#4A4A4F",

        "debugExceptionWidget.background": "#2D2D30",
        "debugExceptionWidget.border": "#3E3E42",
        "debugToolBar.background": "#2D2D30",

        "dropdown.background": "#181818",

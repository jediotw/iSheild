        "peekViewTitleDescription.foreground": "#7F848E",
        "peekViewTitleLabel.foreground": "#ABB2BF",

        "pickerGroup.border": "#3A3F4B",
        "pickerGroup.foreground": "#61AFEF",

        "ports.iconRunningProcessForeground": "#98C379",

        "progressBar.background": "#61AFEF",

        "quickInput.background": "#30343D",
        "quickInput.foreground": "#ABB2BF",
        "quickInputList.focusBackground": "#3E4451",
        "quickInputList.focusForeground": "#FFFFFF",

        "selection.background": "#3E4451",


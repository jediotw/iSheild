        "statusBarItem.remoteForeground": "#FFFFFF",

        "surface.border": "#3A3F4B",

        "tab.activeBackground": "#21252B",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveBackground": "#282C34",
        "tab.inactiveForeground": "#7F848E",
        "tab.border": "#3A3F4B",
        "tab.lastPinnedBorder": "#56B6C2",
        "tab.unfocusedActiveForeground": "#ABB2BF",
        "tab.unfocusedInactiveForeground": "#5C6370",

        "terminal.background": "#21252B",
        "terminal.foreground": "#ABB2BF",
        "terminalCursor.foreground": "#ABB2BF",

        "terminal.ansiBlack": "#1F2329",
        "terminal.ansiRed": "#E06C75",
        "terminal.ansiGreen": "#98C379",
        "terminal.ansiYellow": "#E5C07B",

        "terminal.ansiBrightBlack": "#5C6370",
        "terminal.ansiBrightRed": "#E06C75",
        "terminal.ansiBrightGreen": "#98C379",
        "terminal.ansiBrightYellow": "#E5C07B",
        "terminal.ansiBrightBlue": "#61AFEF",
        "terminal.ansiBrightMagenta": "#C678DD",
        "terminal.ansiBrightCyan": "#56B6C2",
        "terminal.ansiBrightWhite": "#FFFFFF",

        "textLink.foreground": "#61AFEF",
        "textLink.activeForeground": "#56B6C2",

        "titleBar.activeBackground": "#282C34",
        "titleBar.activeForeground": "#ABB2BF",
        "titleBar.inactiveBackground": "#282C34",
        "titleBar.inactiveForeground": "#7F848E"
    },

    "tokenColors": [
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "variable.legacy.builtin.python"
            ],
            "settings": {
                "foreground": "#ABB2BF"
            }
        },

        {
            "scope": "comment",
            "settings": {
                "foreground": "#7F848E",
                "fontStyle": "italic"
            }
        },

        {
            "scope": "string",
            "settings": {
                "foreground": "#98C379"
            }
        },

        {
            "scope": "string.regexp",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#D19A66"
            }
        },

        {
            "scope": [
                "variable.language",
                "variable.other"
            ],
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": "keyword",
            "settings": {
                "foreground": "#C678DD"
            }
        },

        {
            "scope": "storage",
            "settings": {
                "foreground": "#C678DD",
                "fontStyle": "bold"
            }
        },

        {
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.namespace",
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#E5C07B",
                "fontStyle": ""
            }
        },

        {
            "scope": "entity.name.function",
            "settings": {
                "foreground": "#61AFEF"
            }
        },

        {
            "scope": "punctuation.definition.variable",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": [
                "constant.language",
                "meta.preprocessor"
            ],
            "settings": {
                "foreground": "#56B6C2"
            }
        },

        {
            "scope": [
                "support.function.construct",
                "keyword.other.new"
            ],
            "settings": {
                "foreground": "#C678DD"
            }
        },

        {
            "scope": [
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#D19A66"
            }
        },

        {
            "scope": [
                "entity.other.inherited-class",
                "punctuation.separator.namespace.ruby"
            ],
            "settings": {
                "foreground": "#E5C07B"
            }
        },

        {
            "scope": "variable.parameter",
            "settings": {
                "foreground": "#D19A66"
            }
        },

        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": "punctuation.definition.tag",
            "settings": {
                "foreground": "#ABB2BF"
            }
        },

        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#D19A66"
            }
        },

        {
            "scope": "support.function",
            "settings": {
                "foreground": "#61AFEF"
            }
        },

        {
            "scope": "punctuation.separator.continuation",
            "settings": {
                "foreground": "#C678DD"
            }
        },

        {
            "scope": [
                "support.constant",
                "support.variable"
            ],
            "settings": {
                "foreground": "#61AFEF"
            }
        },

        {
            "scope": [
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#E5C07B"
            }
        },

        {
            "scope": "support.type.exception",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": "support.other.variable",
            "settings": {
                "foreground": "#61AFEF"
            }
        },

        {
            "scope": "invalid",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": [
                "meta.diff",
                "meta.diff.header"
            ],
            "settings": {
                "foreground": "#61AFEF",
                "fontStyle": "italic"
            }
        },

        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#E5C07B"
            }
        },

        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#98C379"
            }
        },

        {
            "scope": "markup.quote",
            "settings": {
                "foreground": "#98C379"
            }
        },

        {
            "scope": "markup.list",
            "settings": {
                "foreground": "#D19A66"
            }
        },

        {
            "scope": [
                "markup.bold",
                "markup.italic"
            ],
            "settings": {
                "foreground": "#C678DD"
            }
        },

        {
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold"
            }
        },

        {
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },

        {
            "scope": "markup.strikethrough",
            "settings": {
                "fontStyle": "strikethrough"
            }
        },

        {
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#98C379",
                "fontStyle": ""
            }
        },

        {
            "scope": "markup.heading",
            "settings": {
                "foreground": "#61AFEF",
                "fontStyle": "bold"
            }
        },

        {
            "scope": "markup.heading.setext",
            "settings": {
                "foreground": "#61AFEF",
                "fontStyle": ""
            }
        },

        {
            "scope": "token.info-token",
            "settings": {
                "foreground": "#61AFEF"
            }
        },

        {
            "scope": "token.warn-token",
            "settings": {
                "foreground": "#E5C07B"
            }
        },

        {
            "scope": "token.error-token",
            "settings": {
                "foreground": "#E06C75"
            }
        },

        {
            "scope": "token.debug-token",
            "settings": {
                "foreground": "#C678DD"
            }
        }
    ]
}
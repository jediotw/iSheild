        "editorWidget.border": "#3A3F4B",

        "errorForeground": "#E06C75",

        "focusBorder": "#61AFEF",

        "input.background": "#1F2329",
        "input.foreground": "#ABB2BF",
        "input.border": "#3A3F4B",
        "input.placeholderForeground": "#7F848E",
        "inputOption.activeBorder": "#56B6C2",

        "inputValidation.errorBackground": "#3A2026",
        "inputValidation.errorBorder": "#E06C75",

        "inputValidation.infoBackground": "#202F3A",
        "inputValidation.infoBorder": "#61AFEF",

        "inputValidation.warningBackground": "#3A3322",
        "inputValidation.warningBorder": "#E5C07B",

        "list.activeSelectionBackground": "#3E4451",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.dropBackground": "#61AFEF33",
        "list.focusBackground": "#30343D",
        "list.focusForeground": "#FFFFFF",
        "list.highlightForeground": "#61AFEF",
        "list.hoverBackground": "#30343D",
        "list.inactiveSelectionBackground": "#353A43",
        "list.inactiveSelectionForeground": "#ABB2BF",

        "minimap.background": "#21252B",
        "minimap.selectionHighlight": "#3E4451",

        "modernActivityBar.activeBackground": "#30343D",
        "modernActivityBar.background": "#282C34",
        "modernActivityBar.hoverBackground": "#30343D",

        "notificationCenter.border": "#3A3F4B",
        "notificationCenterHeader.background": "#282C34",
        "notificationCenterHeader.foreground": "#ABB2BF",

        "notifications.background": "#30343D",
        "notifications.foreground": "#ABB2BF",
        "notifications.border": "#3A3F4B",

        "notificationToast.border": "#3A3F4B",

        "notificationsErrorIcon.foreground": "#E06C75",
        "notificationsWarningIcon.foreground": "#E5C07B",
        "notificationsInfoIcon.foreground": "#61AFEF",

        "panel.background": "#21252B",
